{
  "name": "chomy-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "start": "pnpm build && pnpm --filter @chomy/desktop start",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "package": "pnpm build && pnpm --filter @chomy/desktop package",
    "make": "pnpm build && pnpm --filter @chomy/desktop make && node scripts/make-dmg.mjs",
    "postinstall": "node scripts/install-electron.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "package:win": "pnpm build && node scripts/package-win.mjs && node scripts/make-win-zip.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "notices": "node scripts/dependency-notices.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
